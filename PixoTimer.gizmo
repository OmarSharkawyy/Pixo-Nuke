Gizmo {
 inputs 0
 name PixoTimer
 tile_color 0x476581ff
 label "Pixo Timer"
 addUserKnob {20 timer_tab l Timer}
 addUserKnob {1 server l "ComfyUI URL" t "Base URL of the ComfyUI server to watch. It can be any server, local or on the network."}
 server http://127.0.0.1:8188
 addUserKnob {22 start_watch l "Start Watching" +STARTLINE t "Start timing whatever ComfyUI runs, including jobs started from the ComfyUI page or other tools." T "from pixo import timer_ui; timer_ui.start(nuke.thisNode())"}
 addUserKnob {22 stop_watch l Stop -STARTLINE T "from pixo import timer_ui; timer_ui.stop(nuke.thisNode())"}
 addUserKnob {1 status l Status +DISABLED +STARTLINE}
 status "Not watching"
 addUserKnob {1 detail l Job +DISABLED +STARTLINE}
 addUserKnob {1 estimate l Estimate +DISABLED +STARTLINE t "Time left for the running job. It follows the sampler steps in ComfyUI's log and the earlier runs of the same workflow, so it gets more accurate each time that workflow runs."}
 addUserKnob {1 last_run l "Last run" +DISABLED +STARTLINE}
 addUserKnob {1 session l Session +DISABLED +STARTLINE}
 addUserKnob {1 watch_token +INVISIBLE}
 addUserKnob {26 about l "" +STARTLINE T "<b>Pixo Timer</b><br>Shows how long the current ComfyUI run has been going, on this panel and on the node in the Node Graph.<br>It reads the server's queue and history, so it also times runs started outside Nuke.<br>Estimate shows the time left, from the sampler steps in ComfyUI's log and earlier runs of the same workflow. It learns from every render, so it gets more accurate the more you render.<br>Last run uses ComfyUI's own start and finish times. A run already going when you press Start Watching shows a lower bound (≥) until it finishes."}
}
 Output {
  inputs 0
  name Output1
  xpos 0
  ypos 100
 }
end_group
